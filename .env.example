# ORBITUNE Environment Configuration Template
# Copy this file to .env and insert your real credentials.

# Google Gemini API Key for AI-ML Chatbot and Genre Detection
GEMINI_API_KEY=your_gemini_api_key_here

# Server configuration (Render sets PORT automatically)
PORT=8000
HOST=0.0.0.0

# Supabase Credentials (optional for backend, used for cloud storage)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_BUCKET_NAME=orbitune-audio
